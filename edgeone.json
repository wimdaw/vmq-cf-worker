{
  "name": "vmq-cf-worker",
  "buildCommand": "pnpm run build",
  "installCommand": "pnpm install",
  "outputDirectory": "./dist",
  "nodeVersion": "20.18.0",
  "cloudFunctions": {
    "maxDuration": 120,
    "regions": {
      "overseas": ["ap-hongkong"]
    }
  },
  "headers": [
    {
      "source": "/console/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/site/assets/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ],
  "schedules": [
    {
      "name": "vmq-tick",
      "cron": "0 3 * * *",
      "path": "/api/cron/tick?token=vmq_cron_7e3b9a1f5d2c",
      "method": "POST",
      "timezone": "Asia/Shanghai"
    }
  ]
}

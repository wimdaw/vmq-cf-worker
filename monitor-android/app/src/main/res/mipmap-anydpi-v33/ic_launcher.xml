<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 13+ 的 adaptive icon。

  和 v26 那份的唯一差别是多了 <monochrome> —— 系统在「主题图标」模式下
  只读这个节点，用它的 alpha 通道按壁纸配色重新着色。

  为什么单独放 -v33 目录而不是直接写进 -v26：
  <monochrome> 是 API 33 才加的标签，放在 -v26 里在 API 26~32 上
  属于未知标签（aapt 能编过，但系统解析行为不保证），
  分目录是最稳的做法。API 33+ 会优先选 v33 这份。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
